<idea-plugin>
    <!--
      id, name and version are injected by patchPluginXml from gradle.properties, so that
      gradle.properties stays the single source of truth for anything the release workflow
      and updatePlugins.xml also need to know.
    -->
    <vendor>Kristian</vendor>

    <description><![CDATA[
        Editor support and linting for <b>Galen Framework</b> page specs (<code>.gspec</code>),
        targeting the Galen spec language v2.x.
        <br/><br/>
        Provides syntax highlighting, a full parser with per-line error recovery, and inspections
        that catch structural mistakes at edit time instead of at the end of a Selenium run.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Galen Spec"
            implementationClass="com.galenlinter.lang.GalenFileType"
            fieldName="INSTANCE"
            language="Galen"
            extensions="gspec"/>

        <lang.parserDefinition
            language="Galen"
            implementationClass="com.galenlinter.lang.GalenParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Galen"
            implementationClass="com.galenlinter.highlight.GalenSyntaxHighlighterFactory"/>

        <annotator
            language="Galen"
            implementationClass="com.galenlinter.highlight.GalenAnnotator"/>

        <colorSettingsPage
            implementation="com.galenlinter.highlight.GalenColorSettingsPage"/>

        <lang.commenter
            language="Galen"
            implementationClass="com.galenlinter.lang.GalenCommenter"/>

        <lang.foldingBuilder
            language="Galen"
            implementationClass="com.galenlinter.highlight.GalenFoldingBuilder"/>

        <lang.findUsagesProvider
            language="Galen"
            implementationClass="com.galenlinter.lang.GalenFindUsagesProvider"/>

        <!-- Without this the platform falls back to Java identifier rules, which reject the
             dashes that Galen object names routinely contain. -->
        <lang.namesValidator
            language="Galen"
            implementationClass="com.galenlinter.lang.GalenNamesValidator"/>

        <completion.contributor
            language="Galen"
            implementationClass="com.galenlinter.completion.GalenCompletionContributor"/>

        <lang.documentationProvider
            language="Galen"
            implementationClass="com.galenlinter.documentation.GalenDocumentationProvider"/>

        <!-- Object-name -> declaring file, so navigation and completion stay flat as the
             project grows and work for files that are not open. -->
        <fileBasedIndex implementation="com.galenlinter.index.GalenObjectIndex"/>

        <!-- Required for rename: PsiReferenceBase delegates writing new text to a manipulator. -->
        <lang.elementManipulator
            forClass="com.galenlinter.psi.GalenObjectNameRef"
            implementationClass="com.galenlinter.resolve.GalenObjectNameRefManipulator"/>

        <lang.elementManipulator
            forClass="com.galenlinter.psi.GalenGroupRef"
            implementationClass="com.galenlinter.resolve.GalenGroupRefManipulator"/>

        <lang.elementManipulator
            forClass="com.galenlinter.psi.GalenFilePathRef"
            implementationClass="com.galenlinter.resolve.GalenFilePathRefManipulator"/>

        <localInspection
            language="Galen"
            shortName="GalenUnresolvedReference"
            displayName="Unresolved object or group reference"
            groupName="Galen"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.galenlinter.inspections.GalenUnresolvedReferenceInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenMissingFile"
            displayName="Referenced file cannot be found"
            groupName="Galen"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.galenlinter.inspections.GalenMissingFileInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenInvalidSpec"
            displayName="Invalid spec arguments"
            groupName="Galen"
            enabledByDefault="true"
            level="ERROR"
            implementationClass="com.galenlinter.inspections.GalenInvalidSpecInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenSuspiciousSpec"
            displayName="Suspicious spec arguments"
            groupName="Galen"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.galenlinter.inspections.GalenSuspiciousSpecInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenObjectNameComment"
            displayName="Object definition silently parsed as a comment"
            groupName="Galen"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.galenlinter.inspections.GL005ObjectNameCommentInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenMixedIndentation"
            displayName="Indentation mixes tabs and spaces"
            groupName="Galen"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.galenlinter.inspections.GL001MixedIndentationInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenInconsistentIndentStep"
            displayName="Inconsistent indentation step"
            groupName="Galen"
            enabledByDefault="true"
            level="WEAK WARNING"
            implementationClass="com.galenlinter.inspections.GL002InconsistentIndentStepInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenTrailingWhitespace"
            displayName="Trailing whitespace"
            groupName="Galen"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.galenlinter.inspections.GL003TrailingWhitespaceInspection"/>

        <localInspection
            language="Galen"
            shortName="GalenMissingFinalNewline"
            displayName="File does not end with a newline"
            groupName="Galen"
            enabledByDefault="false"
            level="WEAK WARNING"
            implementationClass="com.galenlinter.inspections.GL006MissingFinalNewlineInspection"/>
    </extensions>
</idea-plugin>
